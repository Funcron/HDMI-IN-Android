+//======================================================================
+// Parallel MJPEG decode
+//======================================================================
+struct DecoderCtx {
+    tjhandle tj;
+    uint8_t *yuv;       // planar YUV scratch buffer, reused between frames
+    size_t yuvCap;
+
+    DecoderCtx() : tj(NULL), yuv(NULL), yuvCap(0) {}
+};
+
+// static
+void *UVCPreview::decode_thread_func(void *vptr_args) {
+    UVCPreview *preview = reinterpret_cast<UVCPreview *>(vptr_args);
+    preview->decode_loop();
+    return NULL;
+}
+
+/**
+ * Takes compressed frames from the queue until preview stops. Several threads run this
+ * at once; the sequence check in the present step keeps frames in order.
+ */
+void UVCPreview::decode_loop() {
+    DecoderCtx ctx;
+    ctx.tj = tjInitDecompress();
+    if (UNLIKELY(!ctx.tj)) {
+        LOGW("tjInitDecompress failed, using the legacy decode path only");
+    }
+
+    while (LIKELY(isRunning())) {
+        uvc_frame_t *jpeg = waitPreviewFrame();
+        if (UNLIKELY(!jpeg)) continue;
+
+        int fast = -1;
+        // The fast path never builds an RGBX copy of the frame, so it is only used while
+        // nobody is capturing (still capture / video recording / frame callback).
+        if (ctx.tj && !isCapturing()) {
+            fast = decode_and_present_fast(&ctx, jpeg);
+        }
+        if (fast < 0) {
+            // legacy path: MJPEG => RGBX frame => copy to the surface
+            uvc_frame_t *frame = get_frame(jpeg->width * jpeg->height * PREVIEW_PIXEL_BYTES);
+            if (LIKELY(frame)) {
+                if (LIKELY(!uvc_mjpeg2rgbx_tj(jpeg, frame))) {
+                    if (present_rgbx(frame)) {
+                        if (!addCaptureFrame(frame)) {
+                            recycle_frame(frame);
+                        }
+                    } else {
+                        recycle_frame(frame);
+                    }
+                } else {
+                    recycle_frame(frame);
+                }
+            }
+        }
+        recycle_frame(jpeg);
+    }
+
+    if (ctx.tj) tjDestroy(ctx.tj);
+    free(ctx.yuv);
+}
+
+/**
+ * Fast path: decode straight to planar YUV (about 3 MB for 1080p instead of 8 MB of RGBX),
+ * then let libyuv convert it directly into the locked surface buffer. This removes the
+ * RGBX intermediate frame and one full-frame memcpy.
+ */
+int UVCPreview::decode_and_present_fast(DecoderCtx *ctx, uvc_frame_t *jpeg) {
+    // Already behind what is on screen? Skip the decode entirely.
+    // (unlocked read: only a hint, the real check is repeated under the mutex)
+    if ((int32_t) (jpeg->sequence - mLastPresentedSeq) <= 0) {
+        __sync_fetch_and_add(&mStatDropped, 1);
+        return 0;
+    }
+
+    const unsigned char *buf = (const unsigned char *) jpeg->data;
+    const unsigned long size = (unsigned long) jpeg->data_bytes;
+    int w = 0, h = 0, subsamp = 0, colorspace = 0;
+
+    if (tjDecompressHeader3(ctx->tj, buf, size, &w, &h, &subsamp, &colorspace) < 0) {
+        __sync_fetch_and_add(&mStatDropped, 1);
+        return 0;       // truncated or corrupt frame: skip it
+    }
+    if (w != (int) jpeg->width || h != (int) jpeg->height) {
+        __sync_fetch_and_add(&mStatDropped, 1);
+        return 0;
+    }
+    if (colorspace != TJCS_YCbCr ||
+        (subsamp != TJSAMP_420 && subsamp != TJSAMP_422 && subsamp != TJSAMP_444)) {
+        return -1;      // unusual JPEG: let the legacy RGBX path handle it
+    }
+
+    const int uvWidth = tjPlaneWidth(1, w, subsamp);
+    const int uvHeight = tjPlaneHeight(1, h, subsamp);
+    const size_t ySize = (size_t) w * (size_t) h;
+    const size_t uvSize = (size_t) uvWidth * (size_t) uvHeight;
+    const size_t need = ySize + 2 * uvSize;
+    if (ctx->yuvCap < need) {
+        uint8_t *p = (uint8_t *) realloc(ctx->yuv, need);
+        if (UNLIKELY(!p)) return -1;
+        ctx->yuv = p;
+        ctx->yuvCap = need;
+    }
+    unsigned char *planes[3] = {ctx->yuv, ctx->yuv + ySize, ctx->yuv + ySize + uvSize};
+    int strides[3] = {w, uvWidth, uvWidth};
+
+    if (tjDecompressToYUVPlanes(ctx->tj, buf, size, planes, w, strides, h, DECODE_FLAGS) < 0) {
+        __sync_fetch_and_add(&mStatDropped, 1);
+        return 0;
+    }
+
+    int result = 0;
+    pthread_mutex_lock(&preview_mutex);
+    if (LIKELY(mPreviewWindow && isRunning() &&
+               (int32_t) (jpeg->sequence - mLastPresentedSeq) > 0)) {
+        ANativeWindow_Buffer out;
+        if (LIKELY(ANativeWindow_lock(mPreviewWindow, &out, NULL) == 0)) {
+            const int cw = (w < out.width) ? w : out.width;
+            const int ch = (h < out.height) ? h : out.height;
+            uint8_t *dst = (uint8_t *) out.bits;
+            const int dstStride = out.stride * PREVIEW_PIXEL_BYTES;
+            // The window is RGBA_8888, i.e. bytes R,G,B,A in memory, which libyuv calls ABGR.
+            // J* variants are the full-range YUV that JPEG uses.
+            switch (subsamp) {
+                case TJSAMP_420:
+                    libyuv::J420ToABGR(planes[0], w, planes[1], uvWidth, planes[2], uvWidth,
+                                       dst, dstStride, cw, ch);
+                    break;
+                case TJSAMP_422:
+                    libyuv::J422ToABGR(planes[0], w, planes[1], uvWidth, planes[2], uvWidth,
+                                       dst, dstStride, cw, ch);
+                    break;
+                default:    // TJSAMP_444
+                    libyuv::J444ToABGR(planes[0], w, planes[1], uvWidth, planes[2], uvWidth,
+                                       dst, dstStride, cw, ch);
+                    break;
+            }
+            ANativeWindow_unlockAndPost(mPreviewWindow);
+            mLastPresentedSeq = jpeg->sequence;
+            mStatShown++;
+            result = 1;
+            log_stats_locked();
+        } else {
+            __sync_fetch_and_add(&mStatDropped, 1);
+        }
+    } else {
+        // a newer frame was shown while this one was decoding
+        __sync_fetch_and_add(&mStatDropped, 1);
+    }
+    pthread_mutex_unlock(&preview_mutex);
+    return result;
+}
+
+// Legacy-path counterpart: shows an RGBX frame unless a newer one is already on screen.
+bool UVCPreview::present_rgbx(uvc_frame_t *frame) {
+    bool shown = false;
+    pthread_mutex_lock(&preview_mutex);
+    if (LIKELY(mPreviewWindow && (int32_t) (frame->sequence - mLastPresentedSeq) > 0)) {
+        if (LIKELY(copyToSurface(frame, &mPreviewWindow) == 0)) {
+            mLastPresentedSeq = frame->sequence;
+            mStatShown++;
+            shown = true;
+            log_stats_locked();
+        }
+    } else {
+        __sync_fetch_and_add(&mStatDropped, 1);
+    }
+    pthread_mutex_unlock(&preview_mutex);
+    return shown;
+}
+
+// Logs frames received from USB / shown on screen / dropped, about once per second.
+// Look for "fps: received=" in logcat. Call with preview_mutex held.
+void UVCPreview::log_stats_locked() {
+    const int64_t now = now_ns();
+    const int64_t dt = now - mStatLastLogNs;
+    if (dt >= 1000000000LL) {
+        const uint32_t recv = __sync_lock_test_and_set(&mStatReceived, 0);
+        const uint32_t drop = __sync_lock_test_and_set(&mStatDropped, 0);
+        // direct call (not LOGI) so it prints whatever the LOG_* build flags are
+        __android_log_print(ANDROID_LOG_INFO, "UVCPreviewFps",
+                            "fps: received=%.1f shown=%.1f dropped=%u",
+                            (double) recv * 1e9 / (double) dt,
+                            (double) mStatShown * 1e9 / (double) dt,
+                            (unsigned) drop);
+        // publish for the on-screen overlay (fps * 10, rounded)
+        __atomic_store_n(&gStatRecvX10, (uint32_t) ((double) recv * 1e10 / (double) dt + 0.5),
+                         __ATOMIC_RELAXED);
+        __atomic_store_n(&gStatShownX10, (uint32_t) ((double) mStatShown * 1e10 / (double) dt + 0.5),
+                         __ATOMIC_RELAXED);
+        __atomic_store_n(&gStatDropped, drop, __ATOMIC_RELAXED);
+        __atomic_store_n(&gStatStampMs, now_ms32(), __ATOMIC_RELAXED);
+        __atomic_store_n(&gStatValid, 1, __ATOMIC_RELEASE);
+        mStatShown = 0;
+        mStatLastLogNs = now;
+    }
+}
+
